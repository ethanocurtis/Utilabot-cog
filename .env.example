DISCORD_TOKEN=your_bot_token_here
DATA_PATH=/app/data/bot.db
KUTT_API=
KUTT_HOST=https://your-kutt.example.com
KUTT_API=your_user_api_key_here
# optional:
KUTT_DOMAIN=go.example.com
AFTERSHIP_API_KEY=your_aftership_key_here
TRACKER_DB_PATH=./data/trackings.json
TRACKER_POLL_MINUTES=15
TRACKER_DISABLE_FALLBACK=0
# Keep fallback OFF when you have an API key (default with key is strict ON).
TRACKER_STRICT_PROVIDER=1
# Or, to explicitly allow fallback even with an API key:
# TRACKER_STRICT_PROVIDER=0

# To disable the HTML fallback entirely (even without an API key):
# TRACKER_DISABLE_FALLBACK=1

# Optional: encrypts the Minecraft cog's stored RCON passwords at rest.
# Without this set, RCON passwords are stored in plaintext in data/minecraft_config.json.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MC_SECRET_KEY=

# Optional: lets the server_alerts cog text admins (via email-to-SMS carrier
# gateways) when someone reports a Minecraft issue. Without these set, phone
# numbers can still be added with /alerts sms add, but texts won't send.
# For Gmail: use an App Password (not your normal password) — https://myaccount.google.com/apppasswords
# Port 465 (implicit TLS) and port 587 (STARTTLS) are both handled automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_USE_TLS=1
